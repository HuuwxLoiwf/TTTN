        <mxCell id="ex1" value="Máy chủ Email (SMTP)&#10;gửi OTP, thông báo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="515" width="170" height="60" as="geometry" /></mxCell>
