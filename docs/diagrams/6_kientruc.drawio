        <mxCell id="e4" value="HTTPS / API" style="endArrow=classic;html=1;fontSize=10;strokeColor=#000000;dashed=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c2" target="ex"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== GHI CHU ===== -->
        <mxCell id="note" value="Ghi chú: Hệ thống được xây dựng theo kiến trúc ba tầng (Three-tier Architecture). Tầng trình diễn chạy trên trình duyệt của người dùng dưới dạng ứng dụng một trang (SPA), giao tiếp với máy chủ qua hai kênh song song: REST API theo giao thức HTTP/JSON cho các thao tác dữ liệu thông thường, và WebSocket qua thư viện Socket.IO cho các sự kiện cần cập nhật tức thời. Máy chủ ứng dụng xử lý toàn bộ nghiệp vụ, xác thực bằng JWT và kiểm soát phân quyền theo vai trò trước khi truy cập cơ sở dữ liệu thông qua Prisma ORM." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="70" y="615" width="1110" height="60" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
